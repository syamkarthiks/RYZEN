# =============================================================
#  RYZEN WhatsApp AI Userbot — Environment Variables Template
#  Copy this file to .env and fill in your values.
# =============================================================

# ─── Session ────────────────────────────────────────────────
# Paste the SESSION_ID printed after first login.
# Leave blank on first run to generate a pairing code.
SESSION_ID=

# ─── Bot Behaviour ──────────────────────────────────────────
# Command prefix (default: .)
PREFIX=.

# private  → only respond to DMs / sudo users
# public   → respond to everyone
WORK_TYPE=private

# ─── Owner & Bot Identity ───────────────────────────────────
# Your WhatsApp number with country code (no +), e.g. 919876543210
SUDO=919888280858

BOT_NAME=RYZEN
OWNER_NAME=SY4M

# ─── Sticker Metadata ───────────────────────────────────────
STICKER_NAME=RYZEN
STICKER_AUTHOR=SY4M

# ─── AI / ChatBot ───────────────────────────────────────────
# Get your key at https://platform.openai.com
OPENAI_API_KEY=

# ─── Database ───────────────────────────────────────────────
# Leave blank to use SQLite (stored in /database/ryzen.db)
# Provide a PostgreSQL URL to switch to Postgres automatically.
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# ─── Server ─────────────────────────────────────────────────
# Port for the keep-alive HTTP server (required on Render/Koyeb)
PORT=3000

# ─── Auto Features ──────────────────────────────────────────
# true / false
AUTO_READ=false
AUTO_REACT=false
AUTO_STATUS_SEEN=false
